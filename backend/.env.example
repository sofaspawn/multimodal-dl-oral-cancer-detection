SECRET_KEY=change-me
ENVIRONMENT=development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Postgres (run `docker compose up -d db` to start one locally on :5433 --
# not the default 5432, in case a native Postgres install already owns it).
# Alembic is the source of truth for the schema when using Postgres, so
# table creation on startup is turned off -- run `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://oral_cancer:oral_cancer_dev@localhost:5433/oral_cancer
AUTO_CREATE_TABLES=false

# No-Docker fallback: a local SQLite file, auto-created on startup.
# DATABASE_URL=sqlite:///./oral_cancer.db
# AUTO_CREATE_TABLES=true

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
UPLOAD_DIR=./app/uploads
MAX_FILE_SIZE_MB=10
