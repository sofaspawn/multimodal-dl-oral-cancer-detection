# Copy this file to .env.local and adjust as needed.
# .env.local is git-ignored; this file is committed as the reference.

# Base URL of the FastAPI backend.
# Must match an origin allowed by the CORS middleware in backend/app/main.py.
VITE_API_BASE_URL=http://localhost:8000

# When true, the API layer in src/api/ serves fixtures instead of calling the
# backend. This is what makes the full flow (auth, history, Grad-CAM heatmaps,
# PDF reports) demoable before those endpoints exist.
#
# Set to false to talk to a real `uvicorn app.main:app --reload`. Note that only
# POST /predict is implemented today, so the result page will show its
# pending-inference state rather than a prediction.
VITE_USE_MOCKS=true
